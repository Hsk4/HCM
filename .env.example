# Copy to .env.local and fill in. Values are NOT shell-quoted: `KEY="value"`
# stores the quote characters. Inline `# comments` after a value are not
# stripped by Next either — put comments on their own line.

# ── Database (Neon) ───────────────────────────────────────────────────────────
# Written by `neon deploy`; pooled for the app, unpooled for migrations.
DATABASE_URL=postgres://user:pass@host-pooler/db?sslmode=require
DATABASE_URL_UNPOOLED=postgres://user:pass@host/db?sslmode=require

# ── Auth ──────────────────────────────────────────────────────────────────────
# At least 32 characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-32-plus-chars

# ── AI (optional) ─────────────────────────────────────────────────────────────
# Preferred: the Neon AI Gateway. `neon deploy` injects these when neon.ts has
# `aiGateway: true` (requires a paid Neon plan).
# NEON_AI_GATEWAY_TOKEN=
# NEON_AI_GATEWAY_BASE_URL=
# NEON_AI_GATEWAY_MODEL=gemini-3-flash
# Fallback: a direct Gemini key. Server-side only — never NEXT_PUBLIC_*.
AI_API_KEY=
AI_MODEL=gemini-3.5-flash

# ── First-run bootstrap (optional) ────────────────────────────────────────────
# When set, GET /api/setup provisions the company + admin on an empty database.
ADMIN_EMAIL=
ADMIN_PASSWORD=
COMPANY_NAME=
